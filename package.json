{
  "name": "personal-excalidraw",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "pnpm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply DRAWINGS --local",
    "db:remote": "wrangler d1 migrations apply DRAWINGS --remote",
    "admin:init": "node scripts/init-admin.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "better-auth": "^1.7.7",
    "react": "^18.3.1",
    "react-aria-components": "^1.22.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260930.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  }
}
