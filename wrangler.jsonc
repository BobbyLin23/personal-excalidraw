{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-excalidraw",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "draw.bobbylin.top", "custom_domain": true }],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DRAWINGS", "database_name": "personal-excalidraw", "database_id": "0a3d7297-2348-4f2c-9a4a-1811d35b5205", "migrations_dir": "./migrations" }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "personal-excalidraw-files" }
  ]
}
